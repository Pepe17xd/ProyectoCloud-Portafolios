AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACADEMY_ALLOWED_ACCOUNT=
LAB_ROLE_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_STAGE=academy
AMPLIFY_APP_NAME=
AMPLIFY_BRANCH=main
CORS_ORIGIN=
NOTIFICATION_MODE=disabled
# Optional WhatsApp Business Cloud API configuration. Leave disabled for the
# internal notification inbox only. When enabled, deploy:academy writes the
# complete values below to Secrets Manager and passes only the secret ARN to Lambda.
WHATSAPP_META_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
# Needed for manual webhook subscription in Meta; optional to send messages.
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Set to a currently supported Meta Graph API version (for example vX.Y).
WHATSAPP_GRAPH_VERSION=
# Set true only after confirming these templates are approved in the Meta app.
WHATSAPP_TEMPLATES_APPROVED=false
WHATSAPP_TEMPLATE_VERIFICATION_NAME=
WHATSAPP_TEMPLATE_VERIFICATION_LANGUAGE=es
WHATSAPP_TEMPLATE_REMINDER_NAME=
WHATSAPP_TEMPLATE_REMINDER_LANGUAGE=es
WHATSAPP_TEMPLATE_AUTOMATION_NAME=
WHATSAPP_TEMPLATE_AUTOMATION_LANGUAGE=es
WHATSAPP_TEMPLATE_RISK_ALERT_NAME=
WHATSAPP_TEMPLATE_RISK_ALERT_LANGUAGE=es
WHATSAPP_TEMPLATE_WEEKLY_SUMMARY_NAME=
WHATSAPP_TEMPLATE_WEEKLY_SUMMARY_LANGUAGE=es
# Alternatively, point to an existing per-account/stage Secrets Manager secret.
# Do not set both this ARN and inline Meta credentials.
# WHATSAPP_META_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:cloudportfolio/whatsapp/<account>/<stage>-<suffix>
